# ---- Required: at least one LLM provider ----
GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Optional: stock photos (https://unsplash.com/developers) ----
# UNSPLASH_ACCESS_KEY=

# ---- Models ----
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=openai/gpt-oss-120b
FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# ---- Security ----
ENVIRONMENT=development
# Comma-separated list of allowed browser origins (your Vercel URL in production).
CORS_ORIGINS=http://localhost:3000
# Optional shared secret. If set, the frontend must send it as X-App-Key.
# APP_ACCESS_KEY=
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_DEFAULT=60/minute

# Let visitors use their own provider key (bypasses APP_ACCESS_KEY, never touches your keys)
ALLOW_BYOK=true
